{
  "name": "smart-barber-v1",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w @smart-barber/backend",
    "test:backend": "npm run test -w @smart-barber/backend",
    "dev:admin": "npm run dev -w @smart-barber/deployment-manager",
    "dev:merchant": "npm run dev -w @smart-barber/merchant-app",
    "dev:customer": "npm run dev -w @smart-barber/customer-app",
    "build:admin": "npm run build -w @smart-barber/deployment-manager",
    "build:merchant": "npm run build -w @smart-barber/merchant-app",
    "build:customer": "npm run build -w @smart-barber/customer-app",
    "build": "npm run build:admin && npm run build:merchant && npm run build:customer"
  },
  "devDependencies": {
    "vite": "^7.2.2"
  }
}
